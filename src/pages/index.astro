---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import {
  ArrowRight,
  Check,
  ChevronRight,
  Menu,
  MonitorCheck,
  SlidersHorizontal,
  Sparkles,
  Wrench,
  X,
} from '@lucide/astro';
import logo from '../assets/images/logo.webp';
import s1000 from '../assets/images/s1000orig.png';
import elite from '../assets/images/eliteorig.jpg';
import micron from '../assets/images/micronaloneorig01.png';
import water from '../assets/images/water.jpg';
import buff from '../assets/images/buff.jpeg';

const navItems = [
  { label: 'Overview', href: '#highlights' },
  { label: 'Technology', href: '#tech' },
  { label: 'Performance', href: '#performance' },
  { label: 'Buy', href: '#pricing' },
];

const highlights = [
  {
    eyebrow: 'Purification',
    stat: '99.9%',
    title: 'Contaminants removed.',
    body: 'Three-stage filtration targets chemicals, heavy metals, microplastics, chlorine, chloramine, fluoride, and other everyday tap-water contaminants.',
    dark: true,
  },
  {
    eyebrow: 'Mineralization',
    title: 'Alive, not just clean.',
    body: 'Stealth filters aggressively while preserving naturally occurring source minerals like magnesium, potassium, and calcium for a cleaner water profile that still feels complete.',
    blue: true,
  },
  {
    eyebrow: 'Smart guidance',
    title: 'It learns your water.',
    body: 'Live quality indicators track output and filter life, so the system stays easy to understand without turning hydration into homework.',
    image: buff,
    imageAlt: 'Person holding a glass of Stealth water',
  },
  {
    eyebrow: 'Daily impact',
    impactStats: [
      { value: '0', label: 'Plastic bottles' },
      { value: '1', label: 'Simple system' },
      { value: '2', label: 'Setup paths' },
    ],
    title: 'Drink More. Waste Less.',
    body: 'Skip the cases, refills, delivery runs, and recycling pile. Stealth gives the whole household clean, mineral-balanced water from one daily system built for drinking, cooking, coffee, and bottles on the way out the door.',
    dark: true,
  },
];

const numbers = [
  { value: '6x', label: 'Core stages across purification, reconstruction, and final balancing.' },
  { value: '99.9%', label: 'Targeted contaminant reduction through layered filtration.' },
  { value: '8+', label: 'Mineral and performance markers tracked for taste and output quality.' },
];

const stages = [
  'Strip: 3-stage super filtration',
  'Bypass: beneficial minerals remain',
  'Reconstruct: charged plate chambers',
  'Zap: millivolt polishing',
  'Cluster: active hydrogen line',
  'Balance: final mineral profile',
];

const techPrinciples = [
  {
    title: 'Step 1: Purification',
    body: 'STEALTH uses three super filters to strip contaminants from municipal source water, targeting chemicals, heavy metals, microplastics, chlorine, chloramine, fluoride, herbicides, lead, mercury, nitrates, pharmaceuticals, and more.',
  },
  {
    title: 'Step 2: Bypass miracle',
    body: 'While contaminants are filtered out, naturally occurring beneficial minerals are allowed to remain in the water, including magnesium, potassium, and calcium.',
  },
  {
    title: 'Step 3: Reconstruct',
    body: 'Filtered water enters electrically charged platinum and titanium plate chambers where millivolt energy is used to further polish the water and separate rejected output from the high-density drinking line.',
  },
  {
    title: 'Step 4: Supercharge finish',
    body: 'The final stage is designed around ORP shifts, active hydrogen, and clustered water behavior to create a crisp, mineral-balanced finish.',
  },
];

const stageColors = [
  'bg-cyan-600',
  'bg-cyan-700',
  'bg-blue-700',
  'bg-blue-800',
  'bg-blue-900',
  'bg-indigo-950',
];

const details = [
  {
    eyebrow: 'Countertop performance',
    title: 'Stealth Pro sits where you use it.',
    body: 'The Pro brings Stealth technology into a visible countertop system for homes that want the full experience without under-counter work.',
    icon: MonitorCheck,
  },
  {
    eyebrow: 'Built-in upgrade',
    title: 'Elite disappears under the counter.',
    body: 'Stealth Elite is the integrated installation path, built for a cleaner counter line and a more permanent whole-kitchen water station.',
    icon: Wrench,
  },
  {
    eyebrow: 'Micron polishing',
    title: 'Full Micron sharpens the final pass.',
    body: 'Add Full Micron for an extra layer of filtration detail when the home calls for a focused upgrade to source-water polish.',
    icon: Sparkles,
  },
  {
    eyebrow: 'Daily ownership',
    title: 'Designed for real use.',
    body: 'Guided setup, filter visibility, and product support keep the system feeling premium after the first glass.',
    icon: SlidersHorizontal,
  },
];

const plans = [
  {
    name: 'Stealth Pro',
    slug: 'stealth-pro',
    description: 'The countertop Stealth system for homes that want the full experience in view.',
    price: '4,350',
    cta: 'Learn more',
    popular: false,
    image: s1000,
    imageAlt: 'Stealth Pro countertop water system',
    features: ['Countertop installation', 'Stealth technology platform', 'Multi-stage filtration', 'Mineral-balanced output'],
  },
  {
    name: 'Stealth Elite',
    slug: 'stealth-elite',
    description: 'The under-counter Stealth system for an integrated kitchen setup.',
    price: '5,345',
    cta: 'Learn more',
    popular: true,
    image: elite,
    imageAlt: 'Stealth Elite under-counter water system',
    features: ['Under-counter installation', 'Integrated kitchen profile', 'Advanced filtration path', 'Premium support'],
  },
  {
    name: 'Full Micron',
    slug: 'full-micron',
    description: 'Focused micron filtration for homes adding another polish layer.',
    price: '600',
    cta: 'Learn more',
    popular: false,
    image: micron,
    imageAlt: 'Full Micron filtration unit',
    features: ['Micron filtration upgrade', 'Compact add-on profile', 'Source-water polishing', 'Simple replacement path'],
  },
];

const numberTokenPattern = /(\$?\d+(?:[.,]\d+)?%?\+?)/g;
const textParts = (value) => String(value).split(numberTokenPattern).filter(Boolean);
const isNumberToken = (value) => /\d/.test(value);
---

<BaseLayout title="Stealth Detox Water — Water, reimagined.">
  <style is:global>
    [x-cloak] {
      display: none !important;
    }
  </style>

  <main
    x-data="{
      mobileOpen: false,
      heroProgress: 0,
      selectedPlan: 'Stealth Pro',
      updateHero() {
        const max = window.innerHeight * 1.2;
        this.heroProgress = Math.min(1, Math.max(0, window.scrollY / max));
      },
      updateScrollScaleImages() {
        const viewportHeight = window.innerHeight;

        document.querySelectorAll('[data-scroll-scale-image]').forEach((image) => {
          const frame = image.parentElement;
          const rect = frame.getBoundingClientRect();

          if (rect.bottom < 0 || rect.top > viewportHeight) return;

          const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / (viewportHeight + rect.height)));
          const scale = 1.04 + progress * 0.16;

          image.style.transform = `scale(${scale})`;
        });
      }
    }"
    x-init="
      updateHero();
      updateScrollScaleImages();
      window.addEventListener('scroll', () => requestAnimationFrame(() => { updateHero(); updateScrollScaleImages(); }), { passive: true });
      window.addEventListener('resize', () => requestAnimationFrame(() => { updateHero(); updateScrollScaleImages(); }), { passive: true });
    "
    class="bg-black font-sans text-white"
  >
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#050706] backdrop-blur-xl">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-5 sm:px-8">
        <a href="#hero" class="flex items-center gap-3 text-sm font-semibold tracking-tight text-white">
          <Image src={logo} alt="Stealth Detox Water" class="h-auto w-28" loading="eager" />
        </a>

        <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary navigation">
          {
            navItems.map((item) => (
              <a href={item.href} class="text-xs font-medium text-white/70 transition hover:text-white">
                {item.label}
              </a>
            ))
          }
        </nav>

        <a
          href="#pricing"
          class="hidden rounded-full bg-blue-600 px-4 py-1.5 text-xs font-medium text-white transition hover:bg-blue-500 lg:inline-flex"
        >
          Shop Stealth
        </a>

        <button
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white lg:hidden"
          x-on:click="mobileOpen = !mobileOpen"
          aria-label="Toggle navigation"
          x-bind:aria-expanded="mobileOpen.toString()"
        >
          <Menu class="h-4 w-4" x-show="!mobileOpen" />
          <X class="h-4 w-4" x-show="mobileOpen" x-cloak />
        </button>
      </div>

      <div class="border-t border-white/10 bg-black px-5 py-3 lg:hidden" x-show="mobileOpen" x-transition x-cloak>
        <nav class="grid gap-1" aria-label="Mobile navigation">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="rounded-xl px-3 py-2 text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white"
                x-on:click="mobileOpen = false"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <section id="hero" class="relative flex min-h-[calc(100vh-3.5rem)] items-start justify-center overflow-hidden px-5 pb-0 pt-20 text-center sm:px-8">
      <div class="absolute left-1/2 top-[40%] h-[44rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-600/10 blur-3xl"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black to-transparent"></div>

      <div class="relative mx-auto flex min-h-[calc(100vh-8.5rem)] max-w-6xl flex-col items-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-zinc-500">Introducing</p>
        <h1 class="bg-gradient-to-b from-white via-white to-white/50 bg-clip-text font-display text-6xl font-normal uppercase leading-none tracking-wide text-transparent sm:text-7xl lg:text-[5rem]">
          Stealth
        </h1>
        <p class="mt-4 text-2xl font-normal tracking-tight text-white/70 sm:text-3xl">
          Water, the way it's meant to be.
        </p>
        <p class="mt-5 text-xs font-medium uppercase tracking-[0.18em] text-white/35">
          Filtration · Mineralization · Elevation
        </p>

        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href="/products/stealth-pro"
            class="inline-flex items-center justify-center rounded-full bg-blue-600 px-7 py-3 text-base font-medium text-white transition hover:scale-[1.02] hover:bg-blue-500"
          >
            Buy Now
          </a>
          <!--<a href="#highlights" class="inline-flex items-center gap-1 text-base font-normal text-blue-500 hover:underline">-->
          <!--  Learn more-->
          <!--  <ChevronRight class="h-4 w-4" />-->
          <!--</a>-->
        </div>

        <div class="relative mt-10 flex flex-1 w-full max-w-lg items-end">
          <div class="absolute inset-x-10 bottom-2 h-20 rounded-full bg-black blur-3xl"></div>
          <div class="absolute inset-x-16 top-8 h-28 rounded-full bg-blue-500/20 blur-3xl"></div>
          <div
            class="relative will-change-transform"
            x-bind:style="`transform: translateX(42px) scale(${1 + heroProgress * 1.05}); transform-origin: 50% 8%;`"
          >
            <Image
              src={s1000}
              alt="Stealth Pro countertop water system"
              class="mx-auto h-auto w-full max-w-[21rem] drop-shadow-[0_44px_80px_rgba(0,0,0,0.85)] sm:max-w-[26rem]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <section id="highlights" class="bg-zinc-100 px-5 py-24 text-zinc-950 sm:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center" x-data="{ visible: false }" x-intersect.once="visible = true" x-bind:class="visible ? 'translate-y-0 opacity-100' : 'translate-y-5 opacity-0'" class="transition duration-700">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">What Stealth does</p>
          <h2 class="mt-3 text-4xl font-black uppercase tracking-wide sm:text-6xl">
            As pure as possible
          </h2>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
          {
            highlights.map((item, index) => (
              <article
                class:list={[
                  'rounded-[1.25rem] transition duration-300 hover:-translate-y-1',
                  item.image ? 'aspect-square overflow-hidden bg-white' : 'p-10',
                  index === 3 ? 'aspect-square content-center' : '',
                  item.dark ? 'bg-zinc-900 text-white' : item.blue ? 'bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 text-white' : 'bg-white text-zinc-950',
                ]}
                x-data="{ visible: false }"
                x-intersect.once="visible = true"
                x-bind:class="visible ? 'translate-y-0 opacity-100' : 'translate-y-5 opacity-0'"
              >
                {item.image ? (
                  <Image
                    src={item.image}
                    alt={item.imageAlt}
                    class="block h-full w-full object-cover object-top transition-transform duration-100 ease-out will-change-transform"
                    style="transform: scale(1.04);"
                    data-scroll-scale-image
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                  />
                ) : (
                  <>
                    <p class:list={['mb-3 text-xs font-semibold uppercase tracking-[0.16em]', item.dark || item.blue ? 'text-white/45' : 'text-zinc-500']}>
                      {item.eyebrow}
                    </p>
                    {item.stat && <p class="font-number text-gradient text-7xl tracking-wide">{item.stat}</p>}
                    <h3 class="mt-4 text-3xl font-bold uppercase tracking-wide">{item.title}</h3>
                    <p class:list={['mt-4 text-sm', item.dark || item.blue ? 'text-white/60' : 'text-zinc-500']}>{item.body}</p>
                    {item.impactStats && (
                      <div class="mt-7 grid gap-2">
                        {item.impactStats.map((stat) => (
                          <div class="flex items-center gap-5">
                            <span class="font-number text-gradient text-5xl tracking-wide">{stat.value}</span>
                            <span class="text-5xl uppercase font-semibold tracking-wide text-white/70">{stat.label}</span>
                          </div>
                        ))}
                      </div>
                    )}
                    {item.blue && (
                      <a href="#tech" class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-blue-400 hover:underline">
                        Learn the science
                        <ChevronRight class="h-4 w-4" />
                      </a>
                    )}
                  </>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="tech" class="relative overflow-hidden bg-black px-5 py-24 text-white sm:px-8">
      <Image
        src={water}
        alt=""
        class="water-backdrop absolute inset-0 h-full w-full object-cover object-top"
        widths={[960, 1440, 1920]}
        sizes="100vw"
      />
      <div class="hero-grain absolute inset-0 opacity-20 mix-blend-overlay"></div>
      <div class="absolute bg-gradient-to-br from-black via-black/90 to-blue-950/0"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-black/40"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_35%,rgba(59,130,246,0.28),transparent_34%),linear-gradient(to_bottom,rgba(0,0,0,0.35),rgba(0,0,0,0.92))]"></div>

      <div class="relative mx-auto max-w-7xl">
        <div class="max-w-4xl">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/45">The engine inside</p>
          <h2 class="mt-3 text-4xl font-black uppercase tracking-wide sm:text-6xl">
            Water <span class="text-gradient">reimagined</span>
          </h2>
          <p class="mt-5 max-w-xl text-lg text-white/60">
            In May 2014, STEALTH technology reached its first major breakthrough:
            a reconstruction process built around ORP shifts, millivolt energy,
            active hydrogen, and deeply clustered water behavior.
          </p>
        </div>

        <div class="mt-14 grid gap-8 lg:grid-cols-2 lg:items-center">
          <div>
            <ul class="divide-y divide-white/10">
              {
                techPrinciples.map((item) => (
                  <li class="flex gap-4 py-5">
                    <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-600/15 text-blue-500">
                      <Check class="h-4 w-4" />
                    </span>
                    <div>
                      <strong class="block text-base font-semibold text-white">{item.title}</strong>
                      <p class="mt-1 text-sm leading-6 text-white/55">
                        {item.body}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-[1.25rem] border border-white/10 bg-black/35 p-6 backdrop-blur-sm sm:p-8">
            <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/30">Filtration stages</p>
            <div class="grid gap-1.5">
              {
                stages.map((stage, index) => (
                  <div class:list={['rounded-xl px-5 py-4 text-sm font-medium text-white transition hover:translate-x-2', stageColors[index]]}>
                    Stage {index + 1} — {stage}
                  </div>
                ))
              }
            </div>
            <div class="mt-7 grid grid-cols-2 gap-4 rounded-2xl border border-white/10 bg-white/10 p-6 text-center sm:grid-cols-4">
              <div><p class="font-number text-gradient text-3xl tracking-wide">≤10</p><p class="mt-1 text-[11px] text-white/40">TDS ppm</p></div>
              <div><p class="font-number text-gradient text-3xl tracking-wide">7.8</p><p class="mt-1 text-[11px] text-white/40">pH level</p></div>
              <div><p class="font-number text-gradient text-3xl tracking-wide">-150</p><p class="mt-1 text-[11px] text-white/40">ORP mV</p></div>
              <div><p class="font-number text-gradient text-3xl tracking-wide">0</p><p class="mt-1 text-[11px] text-white/40">Bottles</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-zinc-100 px-5 py-24 text-zinc-950 sm:px-8">
      <div class="relative mx-auto max-w-7xl">
        <div class="mx-auto mb-10 max-w-2xl text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">Made to Optimize</p>
          <h2 class="mt-3 text-4xl font-black uppercase tracking-wide sm:text-6xl">
            As pure as possible
          </h2>
        </div>

        <div class="grid gap-3 md:grid-cols-2">
          <article class="rounded-[1.25rem] bg-white p-10">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500">Capacity</p>
            <p class="mt-3 font-number text-gradient text-7xl tracking-wide">50</p>
            <h3 class="mt-4 text-3xl font-bold uppercase tracking-wide">Gallons per day.</h3>
            <p class="mt-4 text-sm text-zinc-500">Enough for family drinking, cooking, coffee, and refills.</p>
          </article>
          <article class="relative overflow-hidden rounded-[1.25rem] bg-zinc-900 p-10 text-white">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_85%_20%,rgba(59,130,246,0.34),transparent_36%),linear-gradient(135deg,rgba(255,255,255,0.08),transparent_38%)]"></div>
            <div class="hero-grain absolute inset-0 opacity-[0.08] mix-blend-overlay"></div>
            <div class="relative">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Installation</p>
            <h3 class="mt-4 text-3xl font-bold uppercase tracking-wide"><span class="text-gradient">Zero</span> plumber required.</h3>
            <p class="mt-4 text-sm text-white/60">Designed for a direct setup path without turning your kitchen into a jobsite. Get the Stealth Pro in place, connect the system, and start producing mineral-balanced water at home.</p>
            <a href="#pricing" class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-white/75 hover:text-white hover:underline">
              Get started
              <ChevronRight class="h-4 w-4" />
            </a>
            </div>
          </article>
          <article class="relative overflow-hidden rounded-[1.25rem] bg-zinc-950 p-10 text-white shadow-sm ring-1 ring-white/10 md:col-span-2">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_82%_20%,rgba(59,130,246,0.34),transparent_32%),linear-gradient(135deg,rgba(165,243,252,0.12),transparent_34%)]"></div>
            <div class="hero-grain absolute inset-0 opacity-[0.05] mix-blend-overlay"></div>
            <div class="relative grid gap-10 lg:grid-cols-[1fr_24rem] lg:items-center">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Smart monitoring</p>
                <h3 class="mt-4 text-3xl font-bold uppercase tracking-wide">Your water, in real time.</h3>
                <p class="mt-4 max-w-xl text-sm text-white/60">
                  Simple quality indicators show output, filter life, and performance markers so you can see when the system is stripping, balancing, and ready to pour.
                </p>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div class="rounded-2xl bg-white/10 p-5 text-center ring-1 ring-white/10"><p class="text-2xl font-bold">TDS</p><p class="mt-1 text-[11px] text-white/45">Live monitoring</p></div>
                <div class="rounded-2xl bg-white/10 p-5 text-center ring-1 ring-white/10"><p class="text-2xl font-bold text-green-400">Good</p><p class="mt-1 text-[11px] text-white/45">Water quality</p></div>
                <div class="rounded-2xl bg-white/10 p-5 text-center ring-1 ring-white/10"><p><span class="font-number text-2xl tracking-wide">6</span><span class="text-2xl font-bold">mo</span></p><p class="mt-1 text-[11px] text-white/45">Filter life</p></div>
                <div class="rounded-2xl bg-white/10 p-5 text-center ring-1 ring-white/10"><p class="font-number text-2xl tracking-wide text-blue-300">7.8</p><p class="mt-1 text-[11px] text-white/45">Current pH</p></div>
              </div>
            </div>
          </article>
          <div id="performance" class="grid overflow-hidden rounded-[1.25rem] bg-white shadow-sm ring-1 ring-zinc-200 md:col-span-2 sm:grid-cols-3">
            {
              numbers.map((item, index) => (
                <div class="relative px-8 py-14 text-center">
                  {index > 0 && <span class="absolute left-6 right-6 top-0 h-px bg-gradient-to-r from-transparent via-zinc-200 to-transparent sm:bottom-8 sm:left-0 sm:right-auto sm:top-8 sm:h-auto sm:w-px sm:bg-gradient-to-b" />}
                  <p class="font-number text-gradient text-6xl tracking-wide sm:text-7xl">{item.value}</p>
                  <p class="mx-auto mt-4 max-w-48 text-sm leading-6 text-zinc-500">{item.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="relative overflow-hidden bg-zinc-950 px-5 py-24 text-white sm:px-8">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_18%,rgba(59,130,246,0.24),transparent_34%),linear-gradient(135deg,rgba(165,243,252,0.08),transparent_36%)]"></div>
      <div class="hero-grain absolute inset-0 opacity-[0.05] mix-blend-overlay"></div>
      <div class="mx-auto max-w-7xl">
        <div class="relative mb-8 max-w-4xl">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/45">System details</p>
          <h2 class="mt-3 text-4xl font-black uppercase tracking-wide sm:text-5xl">Get <span class="text-gradient">more</span> out of your water</h2>
        </div>
        <div class="relative grid gap-3 md:grid-cols-2">
          {
            details.map(({ eyebrow, title, body, icon: Icon }, index) => (
              <article
                class:list={[
                  'relative overflow-hidden rounded-[1.25rem] p-8 shadow-sm ring-1 transition duration-500 ease-out hover:-translate-y-1',
                  index === 1 ? 'bg-gradient-to-br from-slate-950 via-blue-950 to-slate-900 text-white' : 'bg-white/8 text-white ring-white/10 hover:bg-white/10 hover:ring-blue-400/40',
                ]}
              >
                <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-blue-400/70 to-transparent"></div>
                <div class:list={['flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em]', index === 1 ? 'text-blue-600' : 'text-blue-300']}>
                  <Icon class="h-4 w-4" />
                  <p>{eyebrow}</p>
                </div>
                <h3 class="mt-2 text-2xl font-bold uppercase tracking-wide">{title}</h3>
                <p class:list={['mt-3 text-sm leading-6', index === 1 ? 'text-zinc-500' : 'text-white/60']}>
                  {textParts(body).map((part) => (isNumberToken(part) ? <span class="font-number">{part}</span> : part))}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="pricing" class="bg-zinc-100 px-5 py-24 text-zinc-950 sm:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-16 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">Bring Stealth into your home</p>
          <h2 class="mt-3 text-4xl font-black uppercase tracking-wide sm:text-6xl">
            Choose your Stealth.
          </h2>
        </div>

        <div class="grid gap-4 pt-5 lg:grid-cols-3">
          {
            plans.map((plan) => (
              <article
                class:list={[
                  'group relative rounded-[1.25rem] p-8 pt-10 transition duration-500 ease-out hover:-translate-y-1 hover:shadow-xl',
                  plan.popular
                    ? 'bg-zinc-950 text-white shadow-xl shadow-purple-950/30 ring-1 ring-white/10 hover:shadow-[0_24px_80px_rgba(88,28,135,0.42)]'
                    : 'bg-white text-zinc-950 ring-2 ring-transparent hover:ring-blue-600',
                ]}
              >
                <div class="product-hover-glow"></div>
                {plan.popular && (
                  <div class="absolute left-1/2 top-0 z-20 -translate-x-1/2 -translate-y-[70%] rounded-full bg-gradient-to-r from-fuchsia-500 via-violet-500 to-blue-500 px-4 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-white shadow-lg shadow-purple-950/30">
                    Most Popular
                  </div>
                )}
                <a href={`/products/${plan.slug}`} class:list={['mb-7 flex h-56 items-center justify-center overflow-hidden rounded-2xl p-5', plan.popular ? 'bg-white/10 ring-1 ring-white/10' : 'bg-zinc-100']} aria-label={`Learn more about ${plan.name}`}>
                  <Image
                    src={plan.image}
                    alt={plan.imageAlt}
                    class:list={[
                      'h-full w-full object-contain',
                      plan.name === 'Stealth Elite' ? 'rounded-xl object-cover' : '',
                    ]}
                    widths={[360, 520, 720]}
                    sizes="(min-width: 1024px) 28vw, 90vw"
                  />
                </a>
                <h3 class="text-xl font-bold uppercase tracking-wide">
                  <a href={`/products/${plan.slug}`} class="transition hover:text-blue-500">
                    {textParts(plan.name).map((part) => (isNumberToken(part) ? <span class="font-number">{part}</span> : part))}
                  </a>
                </h3>
                <p class:list={['mt-2 text-sm leading-6', plan.popular ? 'text-white/60' : 'text-zinc-500']}>{plan.description}</p>
                <p class="mt-6 font-number text-6xl tracking-wide"><span class="align-super text-2xl">$</span>{plan.price}</p>
                <p class:list={['mt-1 text-sm', plan.popular ? 'text-white/45' : 'text-zinc-500']}>{plan.name === 'Full Micron' ? 'add-on price' : 'system price'}</p>
                <ul class="mt-8 grid gap-3">
                  {plan.features.map((feature) => (
                    <li class:list={['flex items-center gap-3 text-sm', plan.popular ? 'text-white/75' : 'text-zinc-800']}>
                      <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-green-500 text-white">
                        <Check class="h-3 w-3" />
                      </span>
                      {textParts(feature).map((part) => (isNumberToken(part) ? <span class="font-number">{part}</span> : part))}
                    </li>
                  ))}
                </ul>
                <a
                  href={`/products/${plan.slug}`}
                  class:list={[
                    'mt-8 inline-flex w-full items-center justify-center rounded-xl px-5 py-3 text-base font-medium transition duration-300',
                    plan.popular ? 'bg-blue-600 text-white hover:bg-blue-500' : 'border border-blue-600 text-blue-600 hover:bg-blue-50',
                  ]}
                >
                  {textParts(plan.cta).map((part) => (isNumberToken(part) ? <span class="font-number">{part}</span> : part))}
                </a>
              </article>
            ))
          }
        </div>

        <p class="mt-8 text-center text-sm text-zinc-500">
          Consultation available · Countertop and under-counter paths · Product support from real people
        </p>
      </div>
    </section>

    <!-- TODO add sustainable and big letters behind this section.  -->
    <section class="bg-white px-5 py-24 text-zinc-950 sm:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="mb-12 text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">The Stealth difference</p>
          <h2 class="mt-3 text-4xl font-black uppercase tracking-wide">Drink More. Waste Less.</h2>
        </div>
        <div class="overflow-hidden rounded-2xl ring-1 ring-zinc-200">
          <table class="w-full border-collapse text-left text-sm">
            <thead class="bg-zinc-100 text-xs font-semibold text-zinc-950">
              <tr>
                <th class="px-5 py-4">Feature</th>
                <th class="px-5 py-4">Stealth</th>
                <th class="px-5 py-4">Bottled Water</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 bg-white">
              <tr><td class="px-5 py-4">Plastic waste</td><td class="px-5 py-4 font-medium text-blue-600">Zero routine bottles</td><td class="px-5 py-4 text-zinc-500">Constant disposal</td></tr>
              <tr><td class="px-5 py-4">Convenience</td><td class="px-5 py-4 font-medium text-blue-600">Always home</td><td class="px-5 py-4 text-zinc-500">Shop, carry, store</td></tr>
              <tr><td class="px-5 py-4">Mineral profile</td><td class="px-5 py-4 font-medium text-blue-600">Balanced output</td><td class="px-5 py-4 text-zinc-500">Varies by brand</td></tr>
              <tr><td class="px-5 py-4">Daily experience</td><td class="px-5 py-4 font-medium text-blue-600">Built into your home</td><td class="px-5 py-4 text-zinc-500">A recurring errand</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="contact" class="relative overflow-hidden bg-zinc-950 px-5 py-24 text-white sm:px-8">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(59,130,246,0.22),transparent_32%),linear-gradient(135deg,rgba(165,243,252,0.08),transparent_38%)]"></div>
      <div class="hero-grain absolute inset-0 opacity-[0.05] mix-blend-overlay"></div>
      <div class="relative mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/45">Contact</p>
          <h2 class="mt-3 text-4xl font-black uppercase tracking-wide">Bring Stealth into your home.</h2>
          <p class="mt-5 text-lg leading-8 text-white/60">
            Request product details, pricing, and setup information for Stealth Pro, Stealth Elite, or Full Micron.
          </p>
          <div class="mt-8 grid gap-3 text-sm text-white/55">
            <p><span class="font-semibold text-white">Countertop:</span> Stealth Pro consultation.</p>
            <p><span class="font-semibold text-white">Under-counter:</span> Elite installation path.</p>
            <p><span class="font-semibold text-white">Add-on:</span> Full Micron filtration upgrade.</p>
          </div>
        </div>

        <form
          name="stealth-inquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="company_site"
          class="relative overflow-hidden rounded-[1.25rem] bg-white/10 p-8 shadow-xl shadow-black/20 ring-1 ring-white/10 backdrop-blur-xl"
        >
          <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-blue-300/80 to-transparent"></div>
          <input type="hidden" name="form-name" value="stealth-inquiry" />
          <p class="hidden"><label>Company site <input name="company_site" /></label></p>
          <div class="relative grid gap-5 sm:grid-cols-2">
            <label class="grid gap-2">
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Name</span>
              <input name="name" required class="rounded-xl bg-white/10 px-4 py-3 text-sm font-medium text-white outline-none ring-1 ring-white/10 transition placeholder:text-white/30 focus:ring-2 focus:ring-blue-400" />
            </label>
            <label class="grid gap-2">
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Email</span>
              <input type="email" name="email" required class="rounded-xl bg-white/10 px-4 py-3 text-sm font-medium text-white outline-none ring-1 ring-white/10 transition placeholder:text-white/30 focus:ring-2 focus:ring-blue-400" />
            </label>
            <label class="grid gap-2 sm:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-white/45">Message</span>
              <textarea name="message" rows="5" class="resize-none rounded-xl bg-white/10 px-4 py-3 text-sm font-medium text-white outline-none ring-1 ring-white/10 transition placeholder:text-white/30 focus:ring-2 focus:ring-blue-400"></textarea>
            </label>
          </div>
          <button type="submit" class="relative mt-6 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-base font-medium text-white transition hover:bg-blue-500 sm:w-auto">
            Send Inquiry
            <ArrowRight class="h-4 w-4" />
          </button>
        </form>
      </div>
    </section>
  </main>

  <footer class="bg-[#050706] px-5 py-14 text-white sm:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 flex flex-col gap-6 border-b border-white/10 pb-10 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <Image src={logo} alt="Stealth Detox Water" class="h-auto w-36" />
        </div>
        <a href="#contact" class="inline-flex items-center justify-center rounded-full bg-white px-5 py-2.5 text-sm font-medium text-zinc-950 transition hover:bg-blue-50">
          Start consultation
        </a>
      </div>
      <div class="grid gap-8 border-b border-white/10 pb-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          ['Shop', 'Learn', 'Support', 'Company'].map((group) => (
            <div>
              <p class="mb-3 text-xs font-semibold text-white/65">{group}</p>
              <ul class="grid gap-2">
                <li><a href="#pricing" class="text-xs text-white/40 hover:text-white/80">Stealth Pro</a></li>
                <li><a href="#tech" class="text-xs text-white/40 hover:text-white/80">How it works</a></li>
                <li><a href="#contact" class="text-xs text-white/40 hover:text-white/80">Contact</a></li>
              </ul>
            </div>
          ))
        }
      </div>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-white/30">Copyright © <span class="font-number">2026</span> Stealth Water Systems. All rights reserved.</p>
        <p class="text-base font-semibold text-white/55">Stealth</p>
      </div>
    </div>
  </footer>
</BaseLayout>
